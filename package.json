{
    "name": "link-map",
    "displayName": "Link Map",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Local-first tree & tab-group workspace for Chrome and Edge",
    "author": "Garin / TenTh0usand",
    "license": "AGPL-3.0",
    "engines": {
        "node": ">=18.18.0"
    },
    "scripts": {
        "dev": "wxt",
        "dev:edge": "wxt -b edge",
        "prepare:wxt": "node ./scripts/wxt-cli.mjs prepare",
        "build": "node ./scripts/wxt-cli.mjs build chrome",
        "build:edge": "node ./scripts/wxt-cli.mjs build edge",
        "zip": "node ./scripts/wxt-cli.mjs zip chrome",
        "zip:edge": "node ./scripts/wxt-cli.mjs zip edge",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.14.28",
        "antd": "5.29.3",
        "dexie": "^4.4.7",
        "fflate": "^0.8.3",
        "lucide-react": "^1.78.0",
        "qrcode": "^1.5.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@types/chrome": "^0.3.7",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@wxt-dev/module-react": "^1.2.2",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7",
        "wxt": "^0.21.5"
    },
    "pnpm": {
        "overrides": {
            "@vitejs/plugin-react": "^5.2.0"
        }
    }
}
